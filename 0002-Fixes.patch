 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/sound/pci/ctxfi/ctvmem.h b/sound/pci/ctxfi/ctvmem.h
index da54cbcdb0be4d..43a0065b40c354 100644
--- a/sound/pci/ctxfi/ctvmem.h
