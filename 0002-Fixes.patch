diff --git a/fs/userfaultfd.c b/fs/userfaultfd.c
index bdc84e5219cde3..4b53dc4a32664c 100644
--- a/fs/userfaultfd.c
+++ b/fs/userfaultfd.c
@@ -1238,8 +1238,6 @@ static __always_inline int validate_unaligned_range(
